diff -ruN a/daemon/kwinkscreenhelpereffect.cpp b/daemon/kwinkscreenhelpereffect.cpp
--- a/daemon/kwinkscreenhelpereffect.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/daemon/kwinkscreenhelpereffect.cpp	2026-10-21 23:46:54.166742714 +0200
@@ -0,0 +1,222 @@
+/*
+ *   SPDX-FileCopyrightText: 2015 Kai Uwe Broulik <kde@privat.broulik.de>
+ *
+ *   SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "kwinkscreenhelpereffect.h"
+
+#include <QCoreApplication>
+#include <QGuiApplication>
+#include <QNativeInterface>
+#include <QScopedPointer>
+
+#include <chrono>
+
+#if HAVE_XCB
+#include <xcb/xcb.h>
+#endif
+
+using namespace std::chrono_literals;
+
+namespace PowerDevil
+{
+#if HAVE_XCB
+static xcb_connection_t *x11Connection()
+{
+    if (auto *x11App = qGuiApp->nativeInterface<QNativeInterface::QX11Application>()) {
+        return x11App->connection();
+    }
+    return nullptr;
+}
+
+// QX11Info::appRootWindow() follows the screen in DISPLAY. Qt's QX11Application
+// does not expose that screen, so walk the setup roots the same way.
+static xcb_window_t x11RootWindow(xcb_connection_t *connection)
+{
+    if (!connection) {
+        return XCB_WINDOW_NONE;
+    }
+    const xcb_setup_t *setup = xcb_get_setup(connection);
+    if (!setup) {
+        return XCB_WINDOW_NONE;
+    }
+
+    int screen = 0;
+    const QByteArray display = qgetenv("DISPLAY");
+    const int dot = display.lastIndexOf('.');
+    if (dot >= 0) {
+        bool ok = false;
+        const int parsed = display.mid(dot + 1).toInt(&ok);
+        if (ok) {
+            screen = parsed;
+        }
+    }
+
+    xcb_screen_iterator_t iter = xcb_setup_roots_iterator(setup);
+    for (int i = 0; iter.rem && i < screen; ++i) {
+        xcb_screen_next(&iter);
+    }
+    return iter.data ? iter.data->root : XCB_WINDOW_NONE;
+}
+#endif
+
+KWinKScreenHelperEffect::KWinKScreenHelperEffect(QObject *parent)
+    : QObject(parent)
+{
+    m_abortTimer.setSingleShot(true);
+    m_abortTimer.setInterval(11s);
+    connect(&m_abortTimer, &QTimer::timeout, this, &KWinKScreenHelperEffect::stop);
+
+    qApp->installNativeEventFilter(this);
+}
+
+KWinKScreenHelperEffect::~KWinKScreenHelperEffect()
+{
+    stop();
+}
+
+bool KWinKScreenHelperEffect::start()
+{
+    m_isValid = checkValid();
+    if (!m_isValid) {
+        // emit fade out right away since the effect is not available
+        Q_EMIT fadedOut();
+        return false;
+    }
+
+    m_running = true;
+    setEffectProperty(1);
+    m_abortTimer.start();
+    return true;
+}
+
+void KWinKScreenHelperEffect::stop()
+{
+    // Maybe somebody got confused, just reset the property then
+    if (m_state == NormalState) {
+        setEffectProperty(0);
+    } else {
+        setEffectProperty(3);
+    }
+    m_running = false;
+    m_abortTimer.stop();
+}
+
+bool KWinKScreenHelperEffect::checkValid()
+{
+#if HAVE_XCB
+    xcb_connection_t *connection = x11Connection();
+    if (!connection) {
+        return false;
+    }
+    const xcb_window_t root = x11RootWindow(connection);
+    if (root == XCB_WINDOW_NONE) {
+        return false;
+    }
+
+    QScopedPointer<xcb_list_properties_reply_t, QScopedPointerPodDeleter> propsReply(
+        xcb_list_properties_reply(connection, xcb_list_properties_unchecked(connection, root), nullptr));
+    QScopedPointer<xcb_intern_atom_reply_t, QScopedPointerPodDeleter> atomReply(
+        xcb_intern_atom_reply(connection, xcb_intern_atom_unchecked(connection, false, 25, "_KDE_KWIN_KSCREEN_SUPPORT"), nullptr));
+
+    if (propsReply.isNull() || atomReply.isNull()) {
+        return false;
+    }
+
+    auto *atoms = xcb_list_properties_atoms(propsReply.data());
+    for (int i = 0; i < propsReply->atoms_len; ++i) {
+        if (atoms[i] == atomReply->atom) {
+            m_atom = atomReply->atom;
+            m_root = root;
+            return true;
+        }
+    }
+
+    m_atom = 0;
+    m_root = 0;
+    return false;
+#else
+    return false;
+#endif
+}
+
+void KWinKScreenHelperEffect::setEffectProperty(long value)
+{
+#if HAVE_XCB
+    xcb_connection_t *connection = x11Connection();
+    if (m_isValid && connection && m_root != XCB_WINDOW_NONE) {
+        const uint32_t data = static_cast<uint32_t>(value);
+        xcb_change_property(connection, XCB_PROP_MODE_REPLACE, m_root, m_atom, XCB_ATOM_CARDINAL, 32, 1, &data);
+        xcb_flush(connection);
+    }
+#else
+    Q_UNUSED(value);
+#endif
+}
+
+bool KWinKScreenHelperEffect::nativeEventFilter(const QByteArray &eventType, void *message, qintptr *result)
+{
+    Q_UNUSED(result);
+
+    if (eventType != "xcb_generic_event_t") {
+        return false;
+    }
+
+#if HAVE_XCB
+    xcb_connection_t *connection = x11Connection();
+    if (m_isValid && connection && m_root != XCB_WINDOW_NONE) {
+        auto e = static_cast<xcb_generic_event_t *>(message);
+        const uint8_t type = e->response_type & ~0x80;
+        if (type == XCB_PROPERTY_NOTIFY) {
+            auto *event = reinterpret_cast<xcb_property_notify_event_t *>(e);
+            if (event->window == m_root) {
+                if (event->atom != m_atom) {
+                    return false;
+                }
+
+                auto cookie = xcb_get_property(connection, false, m_root, m_atom, XCB_ATOM_CARDINAL, 0, 1);
+                QScopedPointer<xcb_get_property_reply_t, QScopedPointerPodDeleter> reply(xcb_get_property_reply(connection, cookie, nullptr));
+                if (reply.isNull() || reply.data()->value_len != 1 || reply.data()->format != uint8_t(32)) {
+                    return false;
+                }
+
+                auto *data = reinterpret_cast<uint32_t *>(xcb_get_property_value(reply.data()));
+                if (!data) {
+                    return false;
+                }
+
+                switch (*data) {
+                case 1:
+                    m_state = FadingOutState;
+                    break;
+                case 2:
+                    m_state = FadedOutState;
+                    if (m_running) {
+                        Q_EMIT fadedOut();
+                    }
+                    break;
+                case 3:
+                    m_state = FadingInState;
+                    m_running = false;
+                    m_abortTimer.stop();
+                    break;
+                default:
+                    m_state = NormalState;
+                    m_running = false;
+                }
+
+                Q_EMIT stateChanged(m_state);
+            }
+        }
+    }
+#else
+    Q_UNUSED(message);
+#endif
+
+    return false;
+}
+
+} // namespace PowerDevil
+
+#include "moc_kwinkscreenhelpereffect.cpp"
